# CivicConnect runtime configuration (src/config.js). Names only, never values (NFR-3.5).
# Development: copy to .env (excluded by .gitignore) and run with
#   node --env-file=.env src/server.js
# Production and staging: /etc/civicconnect/<env>.env, loaded by systemd (DEC-003).

# Atlas connection string for this environment's own project and cluster (DEC-003).
# The database user it names is printed at startup and in the smoke record.
MONGODB_URI=

# Port on 127.0.0.1. The listen address is fixed to loopback and is not configurable.
PORT=
