{
  "name": "civicconnect",
  "version": "0.1.0",
  "description": "CivicConnect — Campus Service Request Management Platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node --env-file=.env src/server.js",
    "test": "node --test",
    "test:integration": "node --env-file=.env.test --import \"data:text/javascript,import dns from 'node:dns';dns.setServers(['8.8.8.8','1.1.1.1']);\" --test \"tests/integration/*.test.js\"",
    "lint": "eslint .",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^4.22.3",
    "mongoose": "^8.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0"
  }
}
