  subgraph DAL["Data access layer"]
    REPO["Repositories<br/>only components that query the store"]
    MIG["Versioned migrations — NFR-1.9"]
    LOG["Performance logger<br/>no personal information — NFR-1.11"]
  end

  subgraph STORE["Data store"]
    COLS[("Module-owned collections")]
    TRIG{{"Database triggers write the audit log<br/>CON-015 — application cannot bypass"}}
  end

